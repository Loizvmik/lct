# Шаблон .env для нового окружения. Скопируйте в .env (он в .gitignore,
# секреты сюда и только сюда — не в config/app.yaml).
#
# Yandex Cloud AI Studio (OpenAI-совместимый эндпоинт):
# YANDEX_FOLDER_ID — id каталога в консоли Yandex Cloud (console.cloud.yandex.ru,
#   верхний левый угол, рядом с названием каталога).
# YANDEX_API_KEY — API-ключ сервисного аккаунта с ролью ai.languageModels.user
#   (Yandex Cloud, IAM -> Сервисные аккаунты -> нужный аккаунт -> Создать новый ключ
#   -> API-ключ).
YANDEX_FOLDER_ID=
YANDEX_API_KEY=
