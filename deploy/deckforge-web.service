# systemd unit — веб-интерфейс DeckForge (Next.js, production `next start`,
# не `pnpm dev`) на арендованном сервере (задача Z).
#
# Важно: `NEXT_PUBLIC_API_BASE` зашивается в сборку на этапе `pnpm run
# build` (scripts/setup_ubuntu.sh), а не читается этим unit-файлом в
# рантайме — экспортируйте её ПЕРЕД сборкой. Для схемы из
# deploy/nginx.conf.example (один домен, /api проксируется на 8000) нужно
# пустое значение (относительные пути в браузере): см. docs/DEPLOY.md.
#
# Установка (см. подробности в docs/DEPLOY.md):
#   sudo cp deploy/deckforge-web.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now deckforge-web
[Unit]
Description=DeckForge Web (Next.js, production)
After=network.target deckforge-api.service
Wants=deckforge-api.service

[Service]
Type=simple
User=deckforge
Group=deckforge
WorkingDirectory=/opt/deckforge/web
ExecStart=/usr/bin/env corepack pnpm exec next start --hostname 127.0.0.1 --port 3000
Restart=on-failure
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
